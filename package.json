{
  "name": "react-clamp",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-measured text clamping primitives for React.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pretext": {
      "types": "./dist/pretext.d.ts",
      "import": "./dist/pretext.js",
      "default": "./dist/pretext.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsdown",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:browser": "pnpm run build && playwright test",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && playwright test && publint --strict && node scripts/check-package.mjs",
    "prepack": "pnpm run build",
    "test:upstream:node": "node scripts/run-upstream-suite.mjs node",
    "test:upstream:engine": "node scripts/run-upstream-suite.mjs engine",
    "test:upstream:components": "node scripts/run-upstream-suite.mjs components",
    "test:upstream:demo": "node scripts/run-upstream-suite.mjs demo",
    "test:upstream:types": "node scripts/run-upstream-suite.mjs types",
    "test:upstream:benchmarks": "node scripts/run-upstream-suite.mjs benchmarks && node scripts/summarize-upstream-benchmarks.mjs",
    "test:upstream": "pnpm run test:upstream:node && pnpm run test:upstream:engine && pnpm run test:upstream:components && pnpm run test:upstream:demo && pnpm run test:upstream:types",
    "test:upstream:verify": "node scripts/upstream-verification.mjs --update-inventory .upstream-results/node.json .upstream-results/engine.json .upstream-results/components.json .upstream-results/demo.json .upstream-results/types.json",
    "test:upstream:benchmarks:smoke": "UPSTREAM_BENCHMARK_SMOKE=1 node scripts/run-upstream-suite.mjs benchmarks",
    "dev:lib": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:package": "pnpm build && publint --strict && node scripts/check-package.mjs",
    "release": "bumpp --no-commit --no-tag --no-push",
    "prepare": "node scripts/prepare.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "5.18.6",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "bumpp": "^12.2.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "nano-staged": "^1.0.2",
    "overlayscrollbars": "2.15.1",
    "publint": "^0.3.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "5.0.0",
    "vue": "3.5.30",
    "vue-clamp": "1.7.1"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8"
  },
  "packageManager": "pnpm@10.30.3",
  "homepage": "https://github.com/yunzhencc/react-clamp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunzhencc/react-clamp.git"
  },
  "bugs": "https://github.com/yunzhencc/react-clamp/issues",
  "keywords": [
    "react",
    "clamp",
    "ellipsis",
    "truncate",
    "typescript"
  ],
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  },
  "nano-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --no-warn-ignored --max-warnings=0"
  }
}
